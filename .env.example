# Copy to `.env` and fill in what you need. Every value is optional:
# keys can also be entered in the web UI (LLM Hub tab), where they are stored
# encrypted in SQLite. Values in .env always take precedence over the UI.

# ── Server ────────────────────────────────────────────────
# Keep on localhost unless you add auth in front of it
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8765
# SQLite DB + encryption key live here
NEXUS_DATA_DIR=./data
# Sandbox root for the Filesystem connector
NEXUS_WORKSPACE_DIR=./workspace
# Drop custom connector .py files here
NEXUS_PLUGINS_DIR=./plugins
NEXUS_LOG_LEVEL=INFO

# Fernet key used to encrypt API keys saved from the UI.
# Leave blank to auto-generate one into $NEXUS_DATA_DIR/secret.key on first run.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_SECRET_KEY=

# ── LLM providers ─────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# LiteLLM model string, e.g. anthropic/claude-sonnet-5-5, openai/gpt-5, ollama_chat/llama3.2
NEXUS_DEFAULT_MODEL=ollama_chat/llama3.2

# ── Outbound dispatcher ("Send Stuff") ────────────────────
# false = every outbound tool call (webhook, email, notification) waits for
# approval in the UI. true = fire immediately. Can be toggled live in the UI.
NEXUS_AUTO_APPROVE_OUTBOUND=false
NEXUS_APPROVAL_TIMEOUT_SECONDS=120

# Optional named webhook targets (the LLM refers to them by name, never sees the URL)
NEXUS_DISCORD_WEBHOOK_URL=
NEXUS_SLACK_WEBHOOK_URL=

# SMTP for the email tool
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USERNAME=
NEXUS_SMTP_PASSWORD=
NEXUS_SMTP_FROM=
NEXUS_SMTP_STARTTLS=true

# ── Web fetcher ───────────────────────────────────────────
NEXUS_FETCH_TIMEOUT_SECONDS=15
NEXUS_FETCH_MAX_BYTES=2000000
# Block requests to localhost / private networks (SSRF guard)
NEXUS_FETCH_BLOCK_PRIVATE=true
